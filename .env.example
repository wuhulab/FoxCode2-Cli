# OpenAI 兼容 API 配置
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here

# 可选配置
WORKSPACE_DIR=workspace
TEMPERATURE=0.7
SHELL_TIMEOUT=30
REQUEST_TIMEOUT=120
STREAM_OUTPUT=true

# 代理配置（可选）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,.local
